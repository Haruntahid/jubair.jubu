{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 10,
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    {
      "src": "^/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "^/(?!api)[^.]*$",
      "dest": "/index.html"
    }
  ]
}
