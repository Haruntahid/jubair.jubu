{
  "version": 2,
  "buildCommand": "npm run build && npm run check",
  "outputDirectory": "dist/public",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "^/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "^/(?!api)[^.]*$",
      "dest": "/index.html"
    }
  ]
}
